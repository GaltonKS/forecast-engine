    },
    "dpo_days": {
      "value": 19.57142446713324,
      "method": "payables / monthly cash costs (cogs + opex - depreciation) x 30.4 days, last 3 months with balances",
      "overridden": false
    },
    "capex_monthly": {
      "value": 2000.0,
      "method": "Change in fixed assets + depreciation, last 3 months with consecutive balances",
      "overridden": false
    },
    "depreciation_monthly": {
      "value": 0.0,
      "method": "No depreciation in the income statement; tag depreciation accounts 'depreciation' to model it",
      "overridden": false
    }
  },
  "formulas": {
    "revenue": "revenue[t] = revenue_base * (1 + revenue_growth) ^ t",
    "opex": "opex[t] = opex_base * (1 + opex_growth) ^ t",
    "cogs": "cogs[t] = revenue[t] * (1 - gross_margin)",
    "gross_profit": "gross_profit[t] = revenue[t] - cogs[t]",
    "operating_income": "operating_income[t] = gross_profit[t] - opex[t]",
    "net_income": "net_income[t] = operating_income[t] + other_net + adjustments",
    "adjustments": "Each adjustment adds (currency/month) or scales (pct) its line from start through end",
    "receivables": "receivables[t] = revenue[t] * dso_days / 30.4",
    "inventory": "inventory[t] = cogs[t] * dio_days / 30.4",
    "payables": "payables[t] = (cogs[t] + opex[t] - depreciation_monthly) * dpo_days / 30.4",
    "fixed_assets": "fixed_assets[t] = fixed_assets[t-1] + capex[t] - depreciation_monthly",
    "debt": "debt[t] = debt[t-1] + debt adjustments[t]",
    "equity": "equity[t] = equity[t-1] + net_income[t] + equity adjustments[t]",
    "operating_cash_flow": "net_income + depreciation - change in receivables - change in inventory + change in payables",
    "cash": "cash[t] = cash[t-1] + operating - capex + debt and equity raised"
  },
